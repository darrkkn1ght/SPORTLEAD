# SportLead Africa - Environment Variables Configuration

# Optional: Email Service (SMTP)
# Leave blank to use the built-in local development outbox (logged to data/email-outbox.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@sportleadafrica.com

# Admin Alert Recipient
ADMIN_NOTIFICATION_EMAIL=info@sportleadafrica.com
