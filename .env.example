# SportLead Africa - Environment Variables Configuration
#
# All variables below MUST be set on the deployment platform (e.g. Vercel
# Environment Variables) for form submissions to send email. Without these,
# submissions will succeed but emails will only be logged to the function
# console (not delivered).

# ── SMTP / Nodemailer ──────────────────────────────────────────────────
# For Gmail with an App Password:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASS=your-16-char-app-password
#   SMTP_FROM=info@sportleadafrica.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@sportleadafrica.com

# ── Admin Alert Recipient ──────────────────────────────────────────────
# The email address that receives admin notifications for new submissions.
ADMIN_NOTIFICATION_EMAIL=info@sportleadafrica.com
